# Local development.

# MOCK MODE (current): the whole dashboard runs on in-memory mock data — no
# backend, no database, no Docker needed. Every feature works, including the
# ones whose backend modules do not exist yet.
VITE_USE_MOCKS=true

# Flip to `false` to talk to the real bplay-backend (DB on host 5433, API on
# 3000). In live mode the features whose endpoints have not landed will surface
# a load error instead of mock data.
#VITE_USE_MOCKS=false

# Base URL for live mode. Ignored while VITE_USE_MOCKS=true.
# Defaults to http://localhost:3000/api/v1 when unset; use a LAN IP instead so
# the dashboard also works when opened from another device on the same Wi-Fi.
#VITE_API_BASE_URL=http://10.203.24.216:3000/api/v1
